<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.1.xsd">

    <!-- SF-01-04 : Table des pièces KYC (CNI, passeport, permis, RCCM, etc.) -->
    <changeSet id="0255-1" author="fineract-crm">
        <createTable tableName="crm_kyc_document">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <!-- Lien vers prospect CRM (avant conversion) -->
            <column name="prospect_id" type="BIGINT">
                <constraints nullable="true"/>
            </column>
            <!-- Lien vers client Fineract (après conversion) -->
            <column name="client_id" type="BIGINT">
                <constraints nullable="true"/>
            </column>
            <!--
                Type de pièce :
                  1 = CNI (Carte Nationale d'Identité)
                  2 = PASSEPORT
                  3 = PERMIS_CONDUIRE
                  4 = TITRE_SEJOUR
                  5 = RCCM (Registre Commerce)
                  6 = NIU (Numéro Identifiant Unique fiscal)
                  7 = CARTE_VITALE
                  99 = AUTRE
            -->
            <column name="document_type_enum" type="INT">
                <constraints nullable="false"/>
            </column>
            <!-- Libellé libre si type = AUTRE -->
            <column name="document_type_label" type="VARCHAR(100)">
                <constraints nullable="true"/>
            </column>
            <!-- Numéro de la pièce -->
            <column name="document_number" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>
            <!-- Autorité émettrice (ex: Préfecture de Douala) -->
            <column name="issuing_authority" type="VARCHAR(200)">
                <constraints nullable="true"/>
            </column>
            <!-- Pays d'émission (code ISO 2 lettres) -->
            <column name="issuing_country" type="VARCHAR(2)">
                <constraints nullable="true"/>
            </column>
            <column name="issue_date" type="DATE">
                <constraints nullable="true"/>
            </column>
            <column name="expiry_date" type="DATE">
                <constraints nullable="true"/>
            </column>
            <!--
                Statut du document :
                  0 = ACTIF
                  1 = EXPIRE
                  2 = REVOQUE
                  3 = EN_ATTENTE_VERIFICATION
            -->
            <column name="status_enum" type="INT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <!-- Chemin vers le scan/photo stocké (référence interne) -->
            <column name="file_reference" type="VARCHAR(500)">
                <constraints nullable="true"/>
            </column>
            <!-- SF-01-06 : Niveau de risque LBC/FT associé à ce document -->
            <column name="risk_level_enum" type="INT">
                <constraints nullable="true"/>
            </column>
            <!-- Notes de vérification -->
            <column name="verification_notes" type="TEXT">
                <constraints nullable="true"/>
            </column>
            <!-- Qui a vérifié -->
            <column name="verified_by_user_id" type="BIGINT">
                <constraints nullable="true"/>
            </column>
            <column name="verified_on_date" type="DATE">
                <constraints nullable="true"/>
            </column>
            <column name="created_date" type="DATETIME" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="lastmodified_date" type="DATETIME">
                <constraints nullable="true"/>
            </column>
        </createTable>
    </changeSet>

    <!-- Index pour recherche par prospect -->
    <changeSet id="0255-2" author="fineract-crm">
        <createIndex indexName="idx_crm_kyc_prospect_id" tableName="crm_kyc_document">
            <column name="prospect_id"/>
        </createIndex>
    </changeSet>

    <!-- Index pour recherche par client Fineract -->
    <changeSet id="0255-3" author="fineract-crm">
        <createIndex indexName="idx_crm_kyc_client_id" tableName="crm_kyc_document">
            <column name="client_id"/>
        </createIndex>
    </changeSet>

    <!-- Index pour recherche par numéro de pièce (dédoublonnage SF-01-03) -->
    <changeSet id="0255-4" author="fineract-crm">
        <createIndex indexName="idx_crm_kyc_document_number" tableName="crm_kyc_document">
            <column name="document_number"/>
        </createIndex>
    </changeSet>

    <!-- Index sur date d'expiration (SF-01-05 : alertes 30j avant expiration) -->
    <changeSet id="0255-5" author="fineract-crm">
        <createIndex indexName="idx_crm_kyc_expiry_date" tableName="crm_kyc_document">
            <column name="expiry_date"/>
        </createIndex>
    </changeSet>

    <!-- Contrainte FK vers crm_prospect -->
    <changeSet id="0255-6" author="fineract-crm">
        <addForeignKeyConstraint
            baseTableName="crm_kyc_document"
            baseColumnNames="prospect_id"
            constraintName="fk_crm_kyc_prospect"
            referencedTableName="crm_prospect"
            referencedColumnNames="id"
            onDelete="CASCADE"/>
    </changeSet>

    <!-- Permissions API pour les rôles CRM -->
    <changeSet id="0255-7" author="fineract-crm">
        <insert tableName="m_permission">
            <column name="grouping" value="portfolio"/>
            <column name="code" value="READ_CRM_KYC_DOCUMENT"/>
            <column name="entity_name" value="CRM_KYC_DOCUMENT"/>
            <column name="action_name" value="READ"/>
            <column name="can_maker_checker" valueBoolean="false"/>
        </insert>
        <insert tableName="m_permission">
            <column name="grouping" value="portfolio"/>
            <column name="code" value="CREATE_CRM_KYC_DOCUMENT"/>
            <column name="entity_name" value="CRM_KYC_DOCUMENT"/>
            <column name="action_name" value="CREATE"/>
            <column name="can_maker_checker" valueBoolean="false"/>
        </insert>
        <insert tableName="m_permission">
            <column name="grouping" value="portfolio"/>
            <column name="code" value="UPDATE_CRM_KYC_DOCUMENT"/>
            <column name="entity_name" value="CRM_KYC_DOCUMENT"/>
            <column name="action_name" value="UPDATE"/>
            <column name="can_maker_checker" valueBoolean="false"/>
        </insert>
        <insert tableName="m_permission">
            <column name="grouping" value="portfolio"/>
            <column name="code" value="DELETE_CRM_KYC_DOCUMENT"/>
            <column name="entity_name" value="CRM_KYC_DOCUMENT"/>
            <column name="action_name" value="DELETE"/>
            <column name="can_maker_checker" valueBoolean="false"/>
        </insert>
    </changeSet>

</databaseChangeLog>
