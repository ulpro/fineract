<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.1.xsd">

    <!--
        SF-01-05 : Enregistrement du job Fineract pour la mise à jour quotidienne
        de l'expiration des pièces KYC et les alertes 30j avant expiration.

        Cron : 0 0 1 * * ?  => tous les jours à 01h00 (heure serveur)
        job_key doit correspondre exactement au nom du Bean Spring Batch
        (JobName.UPDATE_KYC_DOCUMENT_EXPIRATION.name() + "JobDetail1 _ DEFAULT")
    -->
    <changeSet id="0256-1" author="fineract-crm">
        <insert tableName="job">
            <column name="name" value="Update KYC Document Expiration"/>
            <column name="display_name" value="Update KYC Document Expiration"/>
            <column name="cron_expression" value="0 0 1 * * ?"/>
            <column name="create_time" valueDate="${current_datetime}"/>
            <column name="task_priority" valueNumeric="5"/>
            <column name="group_name"/>
            <column name="previous_run_start_time"/>
            <column name="job_key" value="Update KYC Document Expiration _ DEFAULT"/>
            <column name="initializing_errorlog"/>
            <column name="is_active" valueBoolean="true"/>
            <column name="currently_running" valueBoolean="false"/>
            <column name="updates_allowed" valueBoolean="true"/>
            <column name="scheduler_group" valueNumeric="0"/>
            <column name="is_misfired" valueBoolean="false"/>
            <column name="node_id" valueNumeric="1"/>
        </insert>
    </changeSet>

</databaseChangeLog>
