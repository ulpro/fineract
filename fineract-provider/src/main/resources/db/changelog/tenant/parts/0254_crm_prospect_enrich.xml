<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.3.xsd">

    <!-- SF-01-01 : Enrichissement crm_prospect pour PP / PM / Groupe solidaire -->
    <changeSet author="neobt-crm" id="0254-crm-prospect-enrich">
        <preConditions onFail="MARK_RAN">
            <not>
                <columnExists tableName="crm_prospect" columnName="date_of_birth"/>
            </not>
        </preConditions>

        <addColumn tableName="crm_prospect">
            <!-- Personne physique -->
            <column name="date_of_birth" type="DATE"/>
            <column name="gender_cv_id" type="BIGINT"/>
            <column name="national_id" type="VARCHAR(100)"/>
            <!-- Personne morale -->
            <column name="company_name" type="VARCHAR(200)"/>
            <column name="rccm_number" type="VARCHAR(50)"/>
            <!-- Groupe solidaire -->
            <column name="group_id" type="BIGINT"/>
        </addColumn>

        <!-- Index pour le dédoublonnage par pièce d'identité (SF-01-03) -->
        <createIndex indexName="idx_crm_prospect_national_id" tableName="crm_prospect">
            <column name="national_id"/>
        </createIndex>

        <!-- Index pour la recherche par groupe solidaire (SF-01-01) -->
        <createIndex indexName="idx_crm_prospect_group_id" tableName="crm_prospect">
            <column name="group_id"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
