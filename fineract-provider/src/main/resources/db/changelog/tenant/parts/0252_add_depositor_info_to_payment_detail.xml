<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.1.xsd">
    <changeSet id="1" author="fineract">
        <preConditions onFail="MARK_RAN">
            <not>
                <columnExists tableName="m_payment_detail" columnName="depositor_name"/>
            </not>
        </preConditions>
        <addColumn tableName="m_payment_detail">
            <column name="depositor_name" type="varchar(150)">
                <constraints nullable="true"/>
            </column>
            <column name="depositor_nationality" type="varchar(100)">
                <constraints nullable="true"/>
            </column>
            <column name="depositor_id_type" type="varchar(50)">
                <constraints nullable="true"/>
            </column>
            <column name="depositor_id_number" type="varchar(100)">
                <constraints nullable="true"/>
            </column>
            <column name="depositor_id_issued_at" type="varchar(150)">
                <constraints nullable="true"/>
            </column>
            <column name="depositor_purpose" type="varchar(255)">
                <constraints nullable="true"/>
            </column>
        </addColumn>
    </changeSet>
</databaseChangeLog>
